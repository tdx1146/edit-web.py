# 敏感文件
*.bak*
*.pem
*.p12
*.key
encrypted/
.locks/
.inject_logs/

# 临时/运行时
__pycache__/
*.pyc
venv/
node_modules/
tmp/
.tmp/

# 编辑器自动存档
*.zip
*.tar.gz

