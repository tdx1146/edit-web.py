    if (data.ok) {
      r.innerHTML = '🌫️ 摸摸协议状态<br>' +
        '<span style="font-size:12px;color:#8b949e">' +
        '协议文档: ' + (data.protocol_ready ? '✅' : '❌') + ' · ' +
        '急救包文件: ' + data.pack_files + ' 个 · ' +
        '日记得分: ' + data.daily_snapshots + ' 天的</span>';
    } else {
      r.textContent = '❌ ' + (data.error || '查询失败');
    }
  } catch(e) {
