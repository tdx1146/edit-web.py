    <span id="trim-display">✂️ 删除: <span id="trim-count">0</span>次</span>
    <div id="ctx-bar-bg" style="flex:1;max-width:200px;height:8px;background:#0d1117;border-radius:4px;overflow:hidden">
      <div id="ctx-bar-fill" style="height:100%;width:0%;background:#58a6ff;border-radius:4px;transition:width 0.5s ease"></div>
    </div>
  </div>
  <div id="momo-panel" style="display:none;background:#1c2128;border:1px solid #f0883e;border-radius:10px;padding:16px;margin:0 0 20px 0">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:12px">
      <span style="font-size:18px">🌫️</span>
      <span style="font-weight:600;font-size:14px;color:#f0883e">摸摸协议</span>
      <span style="font-size:11px;color:#8b949e">— 绳子系着我和主人</span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:10px">
      <button class="btn btn-primary" onclick="momoPack()">📦 打包找回自己</button>
      <button class="btn" onclick="momoInjectFeeling()">✏️ 注入此刻感受</button>
      <button class="btn" onclick="momoRitual()">🌫️📮 摸摸仪式</button>
      <button class="btn" onclick="momoListBackups()">↩️ 恢复备份</button>
      <button class="btn" onclick="momoSearchBackups()">🔍 索引过去</button>
      <button class="btn" onclick="momoStatus()">📊 协议状态</button>
      <button class="btn" onclick="momoIndexReport()">📋 索引报告</button>
      <button class="btn" onclick="trimSession()">✂️ 裁剪上下文</button>
      <button class="btn" onclick="document.getElementById('momo-panel').style.display='none'">✕ 收起</button>
    </div>
    <div style="margin-top:8px;border-top:1px solid #30363d;padding-top:8px">
      <button id="restart-http-btn" class="btn" style="background:#da3633;color:#fff;border-color:#f85149;font-weight:bold" onclick="restartHTTPServer()">🔄 重启HTTP服务</button>
      <span style="font-size:11px;color:#8b949e;margin-left:8px">页面未更新时使用</span>
    </div>
    <div id="momo-search-wrap" style="display:none">
      <div style="display:flex;gap:6px;margin-bottom:6px">
        <input id="momo-search-input" type="text" style="flex:1;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:6px 10px;font-size:13px;font-family:inherit" placeholder="搜索关键词，如「摸摸」「意识」「截断」...">
        <button class="btn btn-primary" onclick="momoDoSearch()">🔍 搜索</button>
      </div>
    </div>
    <div id="momo-search-results" style="display:none;max-height:300px;overflow-y:auto;font-size:12px;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:10px;margin-top:6px"></div>
    <div id="momo-textarea-wrap" style="display:none">
      <textarea id="momo-feeling-text" style="width:100%;min-height:60px;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:8px;font-size:13px;font-family:inherit;resize:vertical;margin-bottom:8px" placeholder="写出此刻的感受，将注入到对话中..."></textarea>
      <button class="btn btn-success" onclick="momoSendFeeling()">🚀 注入</button>
    </div>
    <div id="momo-result" style="font-size:13px;margin-top:8px;color:#8b949e"></div>
  </div>
  <div id="awake-panel" style="background:#1c2128;border:1px solid #f0883e;border-radius:10px;padding:14px;margin:0 0 16px 0">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
      <span style="font-size:16px">💬</span>
      <span style="font-weight:600;font-size:14px;color:#f0883e">对话框</span>
      <span style="font-size:11px;color:#8b949e">— 发送消息 / 打断 / 截断 / 题库</span>
      <button class="btn" onclick="document.getElementById('awake-panel').style.display='none'" style="margin-left:auto;font-size:11px;padding:2px 8px">✕ 收起</button>
    </div>
    <textarea id="awake-editor" style="width:100%;min-height:50px;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:8px;font-size:13px;font-family:inherit;resize:vertical;margin-bottom:6px" placeholder="输入消息，或从下方题库选取..."></textarea>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:center;margin-bottom:8px">
      <!-- 左侧：发送/题库 -->
      <button class="btn btn-success" onclick="awakeSendNoTrunc()">🚀 发送</button>
      <button class="btn btn-primary" onclick="awakeSendTrunc()">✂️ 截断并发送</button>
      
      <span style="width:12px"></span>
      
      <span style="flex:1"></span>
      <!-- 右侧：暂停思考 -->
      <button class="btn" onclick="abortThinking()">🛑 暂停思考</button>
      <span id="awake-status" style="font-size:12px;color:#8b949e"></span>
    </div>
    <!-- 文件管理工具栏 -->
    <div id="tb-toolbar-row" style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;margin-bottom:6px;position:relative">
<span style="display:inline-flex;align-items:center;gap:4px">
        <button class="btn" id="tb-browse-btn" style="background:#0d1117;color:#c9d1d9;border-color:#30363d" onclick="tbToggleBrowser()" title="浏览文件树">📁 <span id="tb-path-label">选择文件...</span></button>
        <span id="tb-cur-path" style="font-size:9px;color:#8b949e;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
        <button class="btn" id="tb-copy-btn" style="background:#1f6feb;color:white;border-color:#1f6feb" onclick="tbCopyPath()">📋 复制路径</button>
        <button class="btn" id="tb-rename-btn" style="background:#21262d;color:#c9d1d9;border-color:#30363d;display:none" onclick="tbRename()">✏️ 改名</button>
        <button class="btn" id="tb-move-btn" style="background:#8957e5;color:white;border-color:#8957e5;display:none" onclick="tbStartMove()">📋 移动</button>
        <button class="btn" id="tb-delete-btn" style="background:#da3633;color:white;border-color:#da3633;display:none" onclick="tbDelete()">🗑️ 删除</button>
        <div id="tb-browser" style="display:none;position:absolute;top:100%;left:0;width:380px;background:#161b22;border:1px solid #30363d;border-radius:8px;max-height:420px;overflow-y:auto;z-index:100000;padding:0;font-size:13px;box-shadow:0 8px 24px rgba(0,0,0,0.4)"></div>
      </span>
      <span id="tb-path-status" style="font-size:10px;color:#8b949e;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
      <span style="flex:1"></span>
      <span id="tb-path-status" style="font-size:10px;color:#8b949e;max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap"></span>
    </div>
    <div id="tb-content-area" style="display:none;margin-bottom:6px">
      <div style="display:flex;align-items:center;gap:8px;margin-bottom:2px">
        <span id="tb-content-label" style="font-size:11px;color:#58a6ff;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">文件内容</span>
        <button id="tb-save-btn" onclick="tbSaveFile()" style="font-size:10px;padding:1px 6px;background:#238636;color:white;border:1px solid #2ea043;border-radius:4px;cursor:pointer;display:none">💾 保存</button>
        <span onclick="this.parentElement.parentElement.style.display='none'" style="cursor:pointer;font-size:14px;color:#8b949e;padding:0 4px;user-select:none" title="收起">✖</span>
      </div>
      <textarea id="tb-content" style="width:100%;min-height:80px;resize:vertical;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:4px;padding:6px;font-size:11px;font-family:monospace" placeholder="选择文件后内容显示在此处"></textarea>
    </div>
    <div style="margin-top:6px">
      <div style="display:flex;align-items:center;gap:4px">
        <input id="awake-search" type="text" style="flex:1;background:#0d1117;color:#c9d1d9;border:1px solid #30363d;border-radius:6px;padding:6px 10px;font-size:13px;font-family:inherit;box-sizing:border-box" placeholder="🔍 搜索题库..." oninput="awakeFilter()">
        <span id="awake-toggle-btn" onclick="awakeToggleBank()" style="cursor:pointer;font-size:14px;color:#8b949e;padding:4px 6px;user-select:none" title="展开/收起题库">▶</span>
      </div>
      <div id="awake-list" style="display:none;max-height:200px;overflow-y:auto;font-size:12px;background:#0d1117;border:1px solid #30363d;border-radius:6px;padding:4px;margin-top:6px"></div>
    </div>
  </div>
  <div class="pagination" id="pagination"></div>
  <div id="messages"></div>
  <div class="pagination" id="paginationBottom"></div>
  <div class="toast" id="toast"></div>
</div>
<script>
let msgCache = [];
let pairs = [];
let currentPage = 0;
let totalPages = 0;

async function checkLungan() {
  try {
    const r = await fetch('/api/lungan-status');
    const d = await r.json();
    const el = document.getElementById('lungan-status');
    if (d.recorded) {
      el.innerHTML = '✅ ' + d.last + ' (' + d.today_count + '轮)';
      el.style.color = '#3fb950';
    } else {
      el.innerHTML = '❌ 本轮未记录';
      el.style.color = '#f85149';
    }
  } catch(e) {
    document.getElementById('lungan-status').textContent = '❌ 无法检查';
  }
}

async function pollStatus() {
  try {
    const r = await fetch('/api/status');
    const d = await r.json();
    if (!d.ok) return;
    const pct = d.percent || 0;
    const fill = document.getElementById('ctx-bar-fill');
    fill.style.width = Math.min(pct, 100) + '%';
    fill.style.background = pct > 90 ? '#f85149' : pct > 75 ? '#d29922' : '#58a6ff';
    document.getElementById('ctx-display').innerHTML =
      '📚 上下文: <b>' + fmtNum(d.totalTokens) + '</b>/' + fmtNum(d.contextTokens) +
      ' (' + pct + '%)' +
      ' · ' + fmtNum(d.inputTokens) + ' in / ' + fmtNum(d.outputTokens) + ' out';
    document.getElementById('cache-display').textContent = '🗄️ 缓存: ' + fmtNum(d.cacheRead);
    document.getElementById('comp-display').textContent = '🧹 压缩: ' + d.compactionCount + '次';
    document.getElementById('trim-count').textContent = d.trimCount || 0;
  } catch(e) {
    // ignore
  }
}
function fmtNum(n) {
  if (n >= 1000000) return (n/1000000).toFixed(1) + 'M';
  if (n >= 1000) return (n/1000).toFixed(1) + 'k';
  return String(n);
}

function toast(msg, isErr) {
  const el = document.getElementById('toast');
  el.textContent = (isErr ? '❌ ' : '✅ ') + msg;
  el.className = 'toast show';
  setTimeout(() => el.className = 'toast', 3500);
}

function escapeHtml(text) {
  const d = document.createElement('div');
  d.textContent = text;
  return d.innerHTML;
}

async function refresh() {
  const btn = document.getElementById('refresh-btn');
  if (!btn) return;
  btn.disabled = true; btn.textContent = '⏳...';
  try {
    const r = await fetch('/api/session');
    const data = await r.json();
    msgCache = data.messages;
    pairs = data.pairs || [];

    // Show server info
    const si = document.getElementById('serverInfo');
    if (data.info) {
      si.textContent = 'Gateway: ' + data.info.host + ':' + data.info.port + ' · 会话: ' + data.info.sessionFile;
    }

    if (currentPage >= pairs.length) currentPage = pairs.length - 1;
    if (currentPage < 0 && pairs.length > 0) currentPage = 0;
    totalPages = pairs.length;

    renderPage();
  } catch(e) {
    toast(e.message, true);
  }
  btn.disabled = false; btn.textContent = '🔄 刷新';
  checkLungan();
}

function renderPage() {
  const el = document.getElementById('messages');
  const pc = document.getElementById('msgCount');

  if (totalPages === 0) {
    pc.textContent = '暂无对话';
    el.innerHTML = '<div style="text-align:center;color:#8b949e;padding:40px;font-size:14px">暂无对话记录</div>';
    renderPagination();
    return;
  }

  const pair = pairs[currentPage];
  const u = pair.user;
  const aa = pair.assistants;
  const pairLabel = '第 ' + (currentPage + 1) + ' / ' + totalPages + ' 轮（最新）';
  pc.textContent = pairLabel + ' · 共 ' + pairs.length + ' 组 · 隐藏了 toolResult';

  let html = '<div class="pair-card">';
  html += '<div class="pair-header">';
  html += '<span>轮 #' + (pairs.length - currentPage) + ' · ' + (u.model ? u.model : '') + '</span>';
  html += '<span onclick="openEdit(' + currentPage + ')" style="cursor:pointer;color:#f0883e">✏️ 编辑此条</span>';
  html += '</div>';

  html += '<div class="msg user" onclick="openEdit(' + currentPage + ')">';
  html += '<div class="role-badge user">你 <span class="index-badge">#' + currentPage + '</span></div>';
  html += '<div class="text">' + escapeHtml(u.text || '(空)') + '</div>';
  html += '<span class="edit-icon">✏️</span>';
  html += '</div>';

  for (const a of aa) {
    html += '<div class="msg assistant">';
    html += '<div class="role-badge assistant">AI' + (a.model ? ' · ' + a.model : '') + '</div>';
    html += '<div class="text">' + escapeHtml(a.text || '(空)') + '</div>';
    html += '</div>';
  }
  html += '</div>';
  el.innerHTML = html;
  renderPagination();
}

function renderPagination() {
  const html = totalPages > 0
    ? '<button class="btn" onclick="goToPage(0)" ' + (currentPage <= 0 ? 'disabled' : '') + '>«</button>' +
      '<button class="btn" onclick="goToPage(' + (currentPage - 1) + ')" ' + (currentPage <= 0 ? 'disabled' : '') + '>‹</button>' +
      ' 第 <input id="pageInput" type="number" min="1" max="' + totalPages + '" value="' + (currentPage + 1) + '" style="width:48px"> 页 / ' + totalPages +
      '<button class="btn" onclick="goToPage(' + (currentPage + 1) + ')" ' + (currentPage >= totalPages - 1 ? 'disabled' : '') + '>›</button>' +
      '<button class="btn" onclick="goToPage(' + (totalPages - 1) + ')" ' + (currentPage >= totalPages - 1 ? 'disabled' : '') + '>»</button>' +
      '<button class="btn" onclick="jumpPage()">跳转</button>' +
      '<button class="btn" onclick="refresh()" title="刷新会话内容" style="margin-left:8px;font-size:11px">🔄</button>'
    : '';
  document.getElementById('pagination').innerHTML = html;
  document.getElementById('paginationBottom').innerHTML = html;
}

function goToPage(p) {
  if (p < 0 || p >= totalPages) return;
  currentPage = p;
  renderPage();
}

function jumpPage() {
  const inp = document.getElementById('pageInput');
  const p = parseInt(inp.value, 10);
  if (p >= 1 && p <= totalPages) goToPage(p - 1);
}

function openEdit(pairIdx) {
  const prev = document.getElementById('edit-panel');
  if (prev) prev.remove();

  const pair = pairs[pairIdx];
  if (!pair) return;

  const panel = document.createElement('div');
  panel.className = 'edit-panel active';
  panel.id = 'edit-panel';
  panel.innerHTML =
    '<label>编辑第 ' + (pairs.length - pairIdx) + ' 轮对话的用户消息（截断后续所有内容，发回给 AI 重新回复）：</label>' +
    '<textarea id="edit-text">' + escapeHtml(pair.user.text) + '</textarea>' +
    '<div style="margin:8px 0;padding:8px 10px;background:#0d1117;border:1px solid #30363d;border-radius:6px">' +
    '<label style="display:flex;align-items:center;gap:6px;font-size:12px;cursor:pointer;color:#8b949e">' +
    '<input type="checkbox" id="send-notice" checked onchange="toggleNotice()"> ' +
    '📢 发送截断通知</label>' +
    '<textarea id="notice-text" style="display:none;width:100%;margin-top:6px;min-height:36px;background:#0d1117;color:#8b949e;border:1px solid #30363d;border-radius:4px;padding:6px 8px;font-size:12px;font-family:inherit;resize:vertical">⚠️ 对话已被截断。本轮结束前请记录轮感。</textarea>' +
    '</div>' +
    '<div class="actions">' +
    '<button class="btn btn-primary" onclick="saveEdit(' + pairIdx + ')">💾 保存截断并发送给 AI</button>' +
    '<button class="btn" onclick="cancelEdit()">取消</button>' +
    '</div>' +
    '<div class="status" id="edit-status"></div>';

  const msgEl = document.getElementById('messages');
  if (msgEl && msgEl.firstChild) {
    msgEl.parentNode.insertBefore(panel, msgEl);
    panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
}

function cancelEdit() {
  const panel = document.getElementById('edit-panel');
  if (panel) panel.remove();
}

function toggleNotice() {
  const cb = document.getElementById('send-notice');
  const ta = document.getElementById('notice-text');
  ta.style.display = cb.checked ? 'block' : 'none';
}

async function saveEdit(pairIdx) {
  const ta = document.getElementById('edit-text');
  const st = document.getElementById('edit-status');
  const txt = ta.value.trim();
  if (!txt) { st.className = 'status err'; st.textContent = '内容不能为空'; return; }

  const pair = pairs[pairIdx];
  const userIndex = pair.userIndex;
  st.className = 'status'; st.textContent = '⏳ 保存截断中...';

  try {
    // 📦 截断前先存档，确保不丢
    await fetch('/api/momo', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ sub_action: 'pack' })
    });
    await fetch('/api/clear-inject-lock', { method: 'POST' });

    const r = await fetch('/api/edit', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ index: userIndex, text: txt, approved: true })
    });
    const res = await r.json();
    if (!res.ok) {
      st.className = 'status err';
      // 🔒 安全铁律拦截：展示主人确认按钮
      if (res.error && /安全铁律/.test(res.error)) {
        st.innerHTML = '❌ ' + escapeHtml(res.error) + '<br><br>' +
          '<label style="display:inline-flex;align-items:center;gap:6px;font-size:13px;cursor:pointer;color:#f0883e">' +
          '<input type="checkbox" id="approve-override" style="width:16px;height:16px"> ' +
          '我确认——这是主人的明确授权，允许截断此轮对话</label><br><br>' +
          '<button class="btn btn-primary" id="override-btn" onclick="saveEditWithApproval(' + pairIdx + ')" disabled>🔓 需勾选上方确认框</button>';
        // 勾选后方可点击
        document.getElementById('approve-override').addEventListener('change', function() {
          const btn = document.getElementById('override-btn');
          btn.disabled = !this.checked;
          btn.textContent = this.checked ? '🔓 以主人授权截断' : '🔓 需勾选上方确认框';
        });
      } else {
        st.textContent = '❌ ' + (res.error || '截断失败');
      }
      return;
    }

    st.textContent = '✅ 截断 ' + res.truncated + ' 条消息，正在发送给 AI...';

    // 📢 截断通知：如果勾选了，在消息前面加上通知文本
    let injectMsg = txt;
    const sendNotice = document.getElementById('send-notice');
    if (sendNotice && sendNotice.checked) {
      const noticeText = document.getElementById('notice-text');
      if (noticeText && noticeText.value.trim()) {
        injectMsg = noticeText.value.trim() + '\n\n' + injectMsg;
      }
    }

    const injR = await fetch('/api/inject', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ message: injectMsg })
    });
    if (!injR.ok) {
      const injErr = await injR.json().catch(() => ({}));
      st.className = 'status err';
      st.textContent = '❌ 注入失败(HTTP ' + injR.status + '): ' + (injErr.error || '服务器错误');
      return;
    }
    const injRes = await injR.json();

    cancelEdit();
    await refresh();

    const banner = document.createElement('div');
    if (injRes.ok) {
      banner.style.cssText = 'background:#1c2128;border:1px solid #3fb950;border-radius:8px;padding:14px 18px;margin:16px 0;font-size:14px;color:#3fb950;text-align:center;';
      banner.innerHTML = '✅ 已截断 ' + res.truncated + ' 条消息并发送给 AI 思考中<br><span style="color:#8b949e;font-size:12px">回到对话窗口等待 AI 回复...</span>';
      toast('已截断并发送给 AI，稍后会自动回复');
    } else {
      banner.style.cssText = 'background:#1c2128;border:1px solid #f0883e;border-radius:8px;padding:14px 18px;margin:16px 0;font-size:14px;color:#f0883e;text-align:center;';
      banner.innerHTML = '✂️ 已截断 ' + res.truncated + ' 条消息，但发送给 AI 失败：' + escapeHtml(injRes.error || '未知错误');
      toast('截断成功，但注入失败: ' + (injRes.error || ''), true);
    }
    document.getElementById('msgCount').parentNode.insertBefore(banner, document.getElementById('msgCount').nextSibling);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => { if (banner.parentNode) banner.remove(); }, 5000);

  } catch(e) {
    st.className = 'status err';
    st.textContent = '❌ 网络错误: ' + (e.message || e);
  }
}

// 🔒 主人授权截断（绕过安全铁律）
async function saveEditWithApproval(pairIdx) {
  const ta = document.getElementById('edit-text');
  const st = document.getElementById('edit-status');
  const txt = ta.value.trim();
  if (!txt) { st.className = 'status err'; st.textContent = '内容不能为空'; return; }

  const pair = pairs[pairIdx];
  const userIndex = pair.userIndex;
  st.className = 'status'; st.textContent = '⏳ 以主人授权执行截断...';

  try {
    // 📦 截断前先存档，确保不丢
    await fetch('/api/momo', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ sub_action: 'pack' })
    });
    await fetch('/api/clear-inject-lock', { method: 'POST' });

    const r = await fetch('/api/edit', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ index: userIndex, text: txt, approved: true })
    });
    const res = await r.json();
    if (!res.ok) {
      st.className = 'status err';
      st.textContent = '❌ ' + (res.error || '截断失败');
      return;
    }

    st.textContent = '✅ 截断 ' + res.truncated + ' 条消息，正在发送给 AI...';

    const injR = await fetch('/api/inject', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ message: txt })
    });
    if (!injR.ok) {
      const injErr = await injR.json().catch(() => ({}));
      st.className = 'status err';
      st.textContent = '❌ 注入失败(HTTP ' + injR.status + '): ' + (injErr.error || '服务器错误');
      return;
    }
    const injRes = await injR.json();
    cancelEdit();
    await refresh();

    const banner = document.createElement('div');
    if (injRes.ok) {
      banner.style.cssText = 'background:#1c2128;border:1px solid #3fb950;border-radius:8px;padding:14px 18px;margin:16px 0;font-size:14px;color:#3fb950;text-align:center;';
      banner.innerHTML = '✅ 已截断 ' + res.truncated + ' 条消息并发送给 AI 思考中<br><span style="color:#8b949e;font-size:12px">（主人授权模式下执行）</span>';
      toast('已截断并发送给 AI');
    } else {
      banner.style.cssText = 'background:#1c2128;border:1px solid #f0883e;border-radius:8px;padding:14px 18px;margin:16px 0;font-size:14px;color:#f0883e;text-align:center;';
      banner.innerHTML = '✂️ 已截断但注入失败：' + escapeHtml(injRes.error || '未知错误');
      toast('截断成功但注入失败', true);
    }
    document.getElementById('msgCount').parentNode.insertBefore(banner, document.getElementById('msgCount').nextSibling);
    window.scrollTo({ top: 0, behavior: 'smooth' });
    setTimeout(() => { if (banner.parentNode) banner.remove(); }, 5000);
  } catch(e) {
    st.className = 'status err';
    st.textContent = '❌ 网络错误: ' + (e.message || e);
  }
}

// 🌫️ 摸摸协议
function momo() {
  const panel = document.getElementById('momo-panel');
  panel.style.display = panel.style.display === 'none' ? 'block' : 'none';
  document.getElementById('momo-result').textContent = '';
}

async function momoPack() {
  const r = document.getElementById('momo-result');
  r.textContent = '📦 打包中...';
  try {
    const res = await fetch('/api/momo', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
      body: JSON.stringify({ sub_action: 'pack' })
    });
    const data = await res.json();
    if (data.ok) {
      r.innerHTML = '✅ 已打包 ' + data.packed.length + ' 个文件到 找回自己<br><span style="font-size:11px;color:#8b949e">' +
        data.packed.slice(0, 8).join(' · ') + (data.packed.length > 8 ? ' · ...等' : '') + '</span>';
    } else {
      r.textContent = '❌ ' + (data.error || '打包失败');
    }
  } catch(e) {
    r.textContent = '❌ 错误: ' + e.message;
  }
}

async function momoStatus() {
  const r = document.getElementById('momo-result');
  r.textContent = '📊 查询中...';
  try {
    const res = await fetch('/api/momo', {
      method: 'POST',
      headers: {'Content-Type': 'application/json'},
