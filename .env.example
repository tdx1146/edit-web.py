# 轻如烟编辑器部署配置模板（2026-08-06）
# 用法：拷贝为 .env（或 export 这些变量），填写本机实际值。
# 优先看 editor-config.json —— 它是"换机器只改这个"的主配置文件。

# ── OpenClaw 位置（本机）──
OPENCLAW_HOME=/path/to/your/openclaw/home
OPENCLAW_JSON=/path/to/your/openclaw/home/openclaw.json
GATEWAY_PORT=10554            # 本机 OpenClaw gateway 端口（inject-helper 用）
HOOKS_URL=http://127.0.0.1:10554   # wake 接口地址

# ── 编辑器 ──
EDITOR_PORT=18888
BUN_BIN=/path/to/bun          # inject-helper.mjs 需要 bun（Node 系运行时）
DATA_DIR=                     # 留空 = 自动发现 OpenClaw sessions 目录

# ── 沙漏数据目录 ──
NEXSANDBASE_HOME=/path/to/sandglass

# ── 模型密钥（api_keys.py 从这里读，填你自己的）──
DEEPSEEK_API_KEY=
GLM_API_KEY=
HUNYUAN_API_KEY=

# ── 可选：唤醒链覆盖 ──
# SELF_PULSE_LMS_URL=http://127.0.0.1:8190/status/main
# SELF_PULSE_BUS_FILE=/path/to/event_bus.jsonl
